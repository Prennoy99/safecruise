{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "gcc14",
      "displayName": "Host build, GCC 14 (ADR-000 D-08)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gcc14",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc-14",
        "CMAKE_BUILD_TYPE": "Debug",
        "SAFECRUISE_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "gcc14", "configurePreset": "gcc14" }
  ],
  "testPresets": [
    {
      "name": "gcc14",
      "configurePreset": "gcc14",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
